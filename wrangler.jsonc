{
  // lev-wifi — Portal de registro a la red WiFi de la Unidad Educativa Lev Vygotsky
  // https://wifi.lev.edu.ec  (estudiantes)   ·   https://wifi.lev.edu.ec/admin/  (TI)
  "name": "lev-wifi",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Base de datos: listado de estudiantes, claves generadas y registro de eventos.
  // Las tablas se crean solas.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lev-wifi",
      // Database ID de D1 → lev-wifi (Cloudflare → Storage & Databases → D1).
      "database_id": "03b783a5-1f0a-41b8-962e-659df8c38ce4"
    }
  ],

  // Las variables y secretos se configuran en el panel de Cloudflare
  // (Worker → Settings → Variables and Secrets). keep_vars evita que
  // un despliegue nuevo las borre.
  "keep_vars": true,
  "vars": {
    // Servidor de la API de Mist según la región de tu organización.
    "MIST_API": "https://api.mist.com"
  }
}
